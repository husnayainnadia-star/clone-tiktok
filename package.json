{
  "name": "clone-tiktok",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,green\" \"npm run server\" \"vite\"",
    "server": "tsx watch --env-file=.env.local server/index.ts",
    "server:once": "tsx --env-file=.env.local server/index.ts",
    "start": "node --import tsx/esm server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/vercel": "^1.0.1",
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.4.17",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
